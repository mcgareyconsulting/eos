# ─────────────────────────────────────────────────────────────────────────────
# EOS environment config.  Copy to .env.local:  cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────
# Local development runs against the SANDBOX Firestore database — a real
# Firebase project, a separate database from prod:
#
#     cp .env.example .env.local
#     # fill in the NEXT_PUBLIC_FIREBASE_* values below
#     gcloud auth application-default login   # once, for the Admin SDK
#     pnpm dev                 # Next.js on http://localhost:3000
# ─────────────────────────────────────────────────────────────────────────────

# --- Firebase web config -----------------------------------------------------
# Firebase console → Project settings → General → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=<from Firebase console>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<from Firebase console>
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<from Firebase console>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<from Firebase console>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<from Firebase console>
NEXT_PUBLIC_FIREBASE_APP_ID=<from Firebase console>

# Which Firestore database in that project to talk to. The databases are listed
# by `firebase firestore:databases:list` and mirrored in firebase.json#firestore.
# Dev uses the sandbox database. Prod uses "hpb-eos-prod-db" — never set that in
# a dev env file. Unset would mean "(default)", which is not where the data is.
NEXT_PUBLIC_FIREBASE_DATABASE_ID=hpb-eos-sandbox-db

# Restricts the Google account picker to your Workspace domain (optional).
# NOTE: this is a UI hint only — it is NOT enforcement, and it can't express
# "domain plus one extra account". Prefer SIGN_IN_ALLOWLIST below.
# NEXT_PUBLIC_FIREBASE_HOSTED_DOMAIN=highplainsbank.com

# --- Admin SDK credentials ---------------------------------------------------
# Server code and the scripts use the Firebase Admin SDK (pick ONE):
#   • Local dev:  run `gcloud auth application-default login` (leave blank here)
#   • CI / scripts off-GCP:  paste a service-account key JSON on one line:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Sign-in perimeter -------------------------------------------------------
# Server-enforced sign-in perimeter (optional; comma-separated). Entries
# starting with "@" allow the whole domain; others are exact emails. Checked
# in createSession() — accounts not matching are refused a session. UNSET =
# open sign-in (fine for a sandbox/trial; set it on any client-facing deploy).
# Keep in lockstep with inDomain() in firestore.rules.
# SIGN_IN_ALLOWLIST=@highplainsbank.com,consultant@example.com

# --- Environment marker ------------------------------------------------------
# So two identical-looking deployments can be told apart (e.g. the client's GCP
# project vs. the consultant's trial). Renders a banner across the app shell and
# a pill on the login/join screens. UNSET = no marker, which is what the "real"
# deployment should run with.
#
# Deliberately NOT a NEXT_PUBLIC_ var: those are inlined at build time, so
# relabelling would need a rebuild. This is read per-request by server
# components, so it can be changed live:
#   gcloud run services update eos --region <r> --update-env-vars ENV_LABEL="TRIAL"
# ENV_LABEL=TRIAL — NOT THE CLIENT PROJECT
# ENV_LABEL_TONE=amber        # amber (default) | red | blue | zinc

# --- Google Tasks connector (optional) ---------------------------------------
# Per-user OAuth; connect from Settings (profile) in the app. Two-way on
# *completion* only: EOS → Google on to-do writes; Google → EOS via pull
# (Settings / To-Dos load, "Sync now", and the background pull route).
# See lib/google/tasks.ts.
#
# Create an OAuth 2.0 "Web application" client in the GCP console
# (APIs & Services → Credentials), enable the Tasks API, and add the scope
# https://www.googleapis.com/auth/tasks to the OAuth consent screen.
# Register these redirect URIs on the client:
#   http://localhost:3000/api/google/tasks/callback
#   https://<your-cloud-run-url>/api/google/tasks/callback
# The connector is disabled (no-op) unless CLIENT_ID and CLIENT_SECRET are set.
#
# Local (pnpm dev): put CLIENT_ID + CLIENT_SECRET in .env.local; leave
# REDIRECT_URI unset so the callback falls back to
# http://localhost:3000/api/google/tasks/callback.
#
# Prod: put all three in .env.prod (gitignored). `pnpm ship` merges them onto
# Cloud Run after the image roll; or push without a rebuild:
#   pnpm ship -- --sync-env
# REDIRECT_URI is REQUIRED on Cloud Run (TLS terminates at the proxy, so a
# request-derived URI would be http:// and Google rejects it).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://eos-….a.run.app/api/google/tasks/callback
#
# Background pull (Cloud Scheduler → POST /api/google/tasks/pull every ~5 min).
# Required for teammates to see Tasks→EOS completions without the owner opening
# the app. Generate a long random string; pass as Authorization: Bearer <secret>.
# Unset = pull route returns 503 (on-demand Sync still works for signed-in users).
# GOOGLE_TASKS_PULL_SECRET=
