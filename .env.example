# ─────────────────────────────────────────────────────────────────────────────
# EOS environment config.  Copy to .env.local:  cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────
# This file ships in LOCAL EMULATOR MODE — copy it and you can run the whole app
# with NO cloud project and NO credentials (see docs/LOCAL_DEV.md):
#
#     cp .env.example .env.local
#     pnpm emulators           # terminal 1  (Firebase Auth + Firestore, local)
#     pnpm dev                 # terminal 2  (Next.js on http://localhost:3000)
#     pnpm seed leader@highplainsbank.com   # once — creates + seeds the demo team
#
# To point at a REAL Firebase project instead, set USE_EMULATOR=false and fill in
# the NEXT_PUBLIC_FIREBASE_* values from the Firebase console (see bottom).
# ─────────────────────────────────────────────────────────────────────────────

# --- LOCAL EMULATOR MODE (default) -------------------------------------------
# Client SDK talks to the local emulators instead of a real project.
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=true

# Admin SDK / seed script auto-detect these and talk to the emulators too.
# (No service-account key or gcloud login needed in emulator mode.)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# In emulator mode any non-empty values work — "demo-" project IDs are the
# Firebase convention for "emulator only, never touches production".
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-hpb-eos
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-hpb-eos.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app

# --- REAL FIREBASE PROJECT MODE ----------------------------------------------
# To use a real project (staging/prod), flip USE_EMULATOR to false, delete the
# two *_EMULATOR_HOST lines above, and fill these in from:
#   Firebase console → Project settings → General → Your apps → Web app.
#
# NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
#
# Only if the project's Firestore DB is NAMED (not "(default)"). Get the id from
# `firebase firestore:databases:list`; must also be set in firebase.json#firestore.
# Leave UNSET for emulator/local dev (talks to "(default)").
# NEXT_PUBLIC_FIREBASE_DATABASE_ID=
#
# Restricts the Google account picker to your Workspace domain (optional).
# NOTE: this is a UI hint only — it is NOT enforcement, and it can't express
# "domain plus one extra account". Prefer SIGN_IN_ALLOWLIST below.
# NEXT_PUBLIC_FIREBASE_HOSTED_DOMAIN=highplainsbank.com
#
# Server-enforced sign-in perimeter (optional; comma-separated). Entries
# starting with "@" allow the whole domain; others are exact emails. Checked
# in createSession() — accounts not matching are refused a session. UNSET =
# open sign-in (fine for the emulator/trial; set it on any client-facing
# deploy). Keep in lockstep with inDomain() in firestore.rules.
# SIGN_IN_ALLOWLIST=@highplainsbank.com,mcgareyconsulting@gmail.com
#
# Admin SDK credentials for a real project (pick ONE):
#   • Local dev:  run `gcloud auth application-default login` (leave blank here)
#   • CI / scripts off-GCP:  paste a service-account key JSON on one line:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Google Tasks connector (optional) ---------------------------------------
# One-way push of L10 to-dos → Google Tasks. Single connected account (see
# lib/google/tasks.ts). Create an OAuth 2.0 "Web application" client in the GCP
# console (APIs & Services → Credentials), enable the Tasks API, and add the
# scope https://www.googleapis.com/auth/tasks to the OAuth consent screen.
# Register these redirect URIs on the client:
#   http://localhost:3000/api/google/tasks/callback
#   https://<your-cloud-run-url>/api/google/tasks/callback
# The connector is disabled (no-op) unless BOTH values are set. In prod, prefer
# storing the secret in Secret Manager over a plain env var.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
#
# Pin the OAuth redirect to ONE exact https callback that's registered on the
# client. REQUIRED on Cloud Run: TLS terminates at the proxy so the request
# reaches the container as http://, and deriving the redirect from it yields an
# http:// URI that Google rejects ("doesn't comply with OAuth 2.0 policy"). Only
# omit locally, where it falls back to the request origin (http on localhost is
# allowed by Google).
# GOOGLE_OAUTH_REDIRECT_URI=https://<your-cloud-run-url>/api/google/tasks/callback
