rules_version = '2';

// Firestore Security Rules for the EOS app.
//
// No client writes: every write is a server action on the Admin SDK (which
// bypasses these rules). Every `write` below is denied.
//
// Client READS (the live onSnapshot listeners) must agree with the server
// access modules in lib/access/** (docs/PERMISSIONS_SPEC.md §6). Each item
// rule below names the module function it mirrors. tests/rules/ holds a
// parity suite that evaluates the module and the rule on the same fixtures.
//
// Lookup budget: Firestore allows 10 get()/exists() document lookups per
// single-document read or query (repeat reads of one document count once).
// Each rule notes its worst case. `myTeamIds()` is always one lookup.

service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- helpers ----------
    function authed() { return request.auth != null; }

    // Admin = Identity Platform custom claim (role: "admin"), granted by HPB to
    // their own admin accounts. Consultant / operator administration happens
    // at the GCP IAM + Admin SDK layer, which bypasses these rules.
    function admin() {
      return authed() && request.auth.token.get('role', '') == "admin";
    }

    // The caller's teams: one get() of users/{uid}.team_ids, server-maintained
    // from team_members (lib/firebase/membership.ts). `users` is not
    // client-writable, so a client cannot forge it. Rostered on a team =
    // `teamId in myTeamIds()` (lib/access isMemberOf). 1 lookup.
    function myTeamIds() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('team_ids', []);
    }
    function onTeam(teamId) {
      return authed() && teamId in myTeamIds();
    }
    // lib/access passesTeamGate: rostered on the item's team, or admin.
    function teamGate(teamId) {
      return admin() || onTeam(teamId);
    }
    function isMe(id) {
      return authed() && id == request.auth.uid;
    }

    // ---------- shape C: rock (lib/access/rock.ts) ----------
    // isPrivateRock: `private` when it is a bool, else legacy `team_only`.
    function rockPrivate(r) {
      return r.get('private', null) is bool
        ? r.private
        : r.get('team_only', false) == true;
    }
    // audienceTeamIdsOf: `audience_team_ids` when the doc has the list (even
    // empty), else legacy `shared_team_ids` (until the P13 migration).
    function rockAudienceTeams(r) {
      return r.get('audience_team_ids', r.get('shared_team_ids', []));
    }
    // seesFullRock: admin, parent team, audience team, audience person. A
    // private rock has no audience whatever is stored. 1 lookup (myTeamIds).
    function rockFull(r) {
      return admin()
        || onTeam(r.team_id)
        || (!rockPrivate(r)
            && (rockAudienceTeams(r).hasAny(myTeamIds())
                || r.get('audience_user_ids', []).hasAny([request.auth.uid])));
    }
    // 2 lookups (the rock + myTeamIds).
    function rockFullById(rockId) {
      return rockId is string
        && rockId != ''
        && rockFull(get(/databases/$(db)/documents/rocks/$(rockId)).data);
    }

    // ---------- to-dos: shapes A, B and milestones ----------
    // lib/item-registry.ts itemTypeOfTodoDoc.
    function isMilestone(t) {
      return t.get('source_rock_id', '') is string && t.get('source_rock_id', '') != '';
    }
    // lib/access: teamTodoAccess / privateTodoAccess / milestoneAccess canSee.
    //   any:        admin, the assignee (owner_id) from any team
    //   team to-do: + members of team_id. A milestone's team_id is its rock's
    //               parent team, so this is the rock's parent-team clause.
    //   private:    + the creator (created_by). Not members, not leaders.
    //   milestone:  + the full-rock set of its rock.
    // Worst case 2 lookups (the rock + myTeamIds).
    function todoSee(t) {
      return admin()
        || isMe(t.get('owner_id', null))
        || (t.visibility != 'private' && onTeam(t.team_id))
        || (t.visibility == 'private'
            && isMe(t.get('created_by', null))
            && !isMilestone(t))
        || (isMilestone(t) && rockFullById(t.source_rock_id));
    }
    // 3 lookups (the to-do, its rock, myTeamIds).
    function todoSeeById(todoId) {
      return todoId is string
        && todoId != ''
        && todoSee(get(/databases/$(db)/documents/todos/$(todoId)).data);
    }

    // ---------- shape A: issue, headline (lib/access/team-item.ts) ----------
    // 2 lookups (the item + myTeamIds).
    function teamItemSeeById(coll, itemId) {
      return itemId is string
        && itemId != ''
        && teamGate(get(/databases/$(db)/documents/$(coll)/$(itemId)).data.team_id);
    }

    // ---------- shape D: metric (lib/access/metric.ts seesMetric) ----------
    // admin, public (every person), home team, tracking team. 1 lookup.
    function metricSee(m) {
      return admin()
        || onTeam(m.team_id)
        || (authed() && m.get('is_public', false) == true)
        || (authed() && m.get('shared_team_ids', []).hasAny(myTeamIds()));
    }

    // ---------- default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- organizations, users, teams, rosters ----------
    // No client listener reads these (every directory read is a server page
    // or action on the Admin SDK), so client reads are denied. The rules'
    // own get() of users/{uid} is not a client read and is unaffected.
    match /organizations/{orgId} { allow read, write: if false; }
    match /users/{uid}           { allow read, write: if false; }
    match /teams/{teamId}        { allow read, write: if false; }
    match /team_members/{id}     { allow read, write: if false; }

    // ---------- scorecard ----------
    // Queries: `team_id == T`, `shared_team_ids array-contains T`. 1 lookup.
    match /scorecard_metrics/{id} {
      allow read:  if metricSee(resource.data);
      allow write: if false;
    }

    // Groups: named buckets within a team's scorecard. 1 lookup.
    match /scorecard_groups/{id} {
      allow read:  if teamGate(resource.data.team_id);
      allow write: if false;
    }

    // Entries inherit their metric (a track is a reference: one set of
    // values). Query: `metric_id in [≤30 ids] and week_start_date >= d`.
    // 2 lookups per document (the metric + myTeamIds).
    match /scorecard_entries/{id} {
      allow read:  if metricSee(get(/databases/$(db)/documents/scorecard_metrics/$(resource.data.metric_id)).data);
      allow write: if false;
    }

    // ---------- rocks ----------
    // Queries: `team_id == T`; `audience_team_ids array-contains T`; legacy
    // `shared_team_ids array-contains T` (until P13). 1 lookup.
    match /rocks/{id} {
      allow read:  if rockFull(resource.data);
      allow write: if false;
    }

    // ---------- rock status updates (immutable history) ----------
    // The rock's full-access rule. `team_id` is always the rock's parent team
    // (setRockStatus refuses any other team, and a rock never changes team),
    // so the `team_id` clause is the parent-team clause of rockFull, stated
    // on the row so the L10's `team_id == T` listener can be proven.
    // Worst case 2 lookups (the rock + myTeamIds).
    match /rock_status_updates/{id} {
      allow read:  if teamGate(resource.data.team_id)
                   || rockFullById(resource.data.rock_id);
      allow write: if false;
    }

    // ---------- to-dos and milestones ----------
    // Queries: `team_id == T and visibility == "team"`; `... visibility ==
    // "private" and owner_id == me`; `... visibility == "private" and
    // created_by == me`; `owner_id == me`; `todos/{id}`.
    // Worst case 2 lookups.
    match /todos/{id} {
      allow read:  if todoSee(resource.data);
      allow write: if false;
    }

    // ---------- issues + per-user votes ----------
    // `comment_count` (the row's comment badge) is written only by the
    // comment actions; the write denial is what keeps a client from forging
    // it. Reading it reveals nothing more than the thread: an issue's thread
    // is gated on the issue's own team_id (teamItemSeeById below).
    match /issues/{id} {
      allow read:  if teamGate(resource.data.team_id);
      allow write: if false;
    }

    // Votes: server-action only (castVote). Query `user_id == me and
    // team_id == T`. 1 lookup.
    match /issue_votes/{id} {
      allow read:  if teamGate(resource.data.team_id);
      allow write: if false;
    }

    // ---------- threads (one per item; spec §5.1) ----------
    // Item-aware: a comment is readable by whoever can see the item it hangs
    // off (lib/firebase/thread-gate.ts → accessFor(type)). The comment's own
    // `team_id` is only its filing team and grants nothing. Every client
    // query pins `entity_type` and `entity_id` by equality, which is what lets
    // the rule get() the parent. Worst case 3 lookups (milestone thread: the
    // to-do, its rock, myTeamIds).
    function threadSee(d) {
      return d.entity_type == 'rock'     ? rockFullById(d.entity_id)
           : d.entity_type == 'todo'     ? todoSeeById(d.entity_id)
           : d.entity_type == 'issue'    ? teamItemSeeById('issues', d.entity_id)
           : d.entity_type == 'headline' ? teamItemSeeById('headlines', d.entity_id)
           : false;
    }
    match /entity_comments/{id} {
      allow read:  if admin() || threadSee(resource.data);
      allow write: if false;
    }

    // ---------- per-entity activity trace ----------
    // One row per event on a to-do (lib/activity.ts). Readable on the same
    // terms as the to-do itself, looked up by `entity_id` (the row's own
    // `visibility` / `owner_id` are a snapshot and grant nothing). Query:
    // `entity_type == "todo" and entity_id == X`. Worst case 3 lookups.
    match /entity_activity/{id} {
      allow read:  if admin()
                   || (resource.data.entity_type == 'todo'
                       && todoSeeById(resource.data.entity_id));
      allow write: if false;
    }

    // ---------- in-app notifications (per-user inbox) ----------
    // A list query must constrain `user_id == request.auth.uid`. 0 lookups.
    match /notifications/{id} {
      allow read:  if authed() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    // ---------- headlines ----------
    // A cascade is fanned out as one doc per team, so `team_id` is the gate
    // (lib/access headlineAccess). 1 lookup.
    match /headlines/{id} {
      allow read:  if teamGate(resource.data.team_id);
      allow write: if false;
    }

    // ---------- meeting agendas (templates) ----------
    // No client reads today; kept on the team gate. 1 lookup.
    match /agendas/{agendaId} {
      allow read:  if teamGate(resource.data.team_id);
      allow write: if false;
    }

    // ---------- meetings (L10) ----------
    // 1 lookup; subcollections 2 (the meeting + myTeamIds).
    match /meetings/{meetingId} {
      allow read:  if teamGate(resource.data.team_id);
      allow write: if false;

      function meetingTeam() {
        return get(/databases/$(db)/documents/meetings/$(meetingId)).data.team_id;
      }

      match /effectiveness_scores/{scoreId} {
        allow read:  if teamGate(meetingTeam());
        allow write: if false;
      }

      match /presence/{uid} {
        allow read:  if teamGate(meetingTeam());
        allow write: if false;
      }
    }

    // ---------- audit log (append-only, function-written) ----------
    match /audit_log/{eventId} {
      allow read:  if admin();
      allow write: if false;
    }

    // ---------- server-only secrets (Admin SDK only) ----------
    match /google_tasks_connections/{uid} { allow read, write: if false; }
    match /oauth_csrf_states/{state}      { allow read, write: if false; }
    // Single-use print-export tokens (lib/export/print-token.ts).
    match /export_print_tokens/{tokenHash} { allow read, write: if false; }
  }
}
