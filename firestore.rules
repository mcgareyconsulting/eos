rules_version = '2';

// Firestore Security Rules for the EOS app.
//
// No client writes: every write is a server action on the Admin SDK (which
// bypasses these rules). The rules below govern client reads only
// (onSnapshot listeners); every `write` is denied.
//
// Reads are gated on team membership via the team_members collection (and,
// for shared lists, users/{uid}.team_ids) + Identity Platform custom claims
// (`role: "normal" | "admin"`).

service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- helpers ----------
    function authed() { return request.auth != null; }

    // Admin = Identity Platform custom claim (role: "admin"), granted by HPB to
    // their own admin accounts. There are no email-allowlisted break-glass
    // accounts: app access is HPB SSO only. Consultant / operator administration
    // happens at the GCP IAM + Admin SDK layer (HPB-granted), which bypasses
    // these rules entirely and needs no app login.
    function admin() {
      return authed() && request.auth.token.role == "admin";
    }

    // Sign-in perimeter (defense-in-depth). Primary enforcement is the
    // server-side SIGN_IN_ALLOWLIST check in createSession()
    // (lib/firebase/session.ts) — the provider-level domain restriction can't
    // express "HPB domain plus the consultant account", so it is NOT used.
    // These rules mirror that allowlist to gate the broad org/user/team reads
    // below, so a token from outside the perimeter can't enumerate them.
    // Keep this list in lockstep with the deployed SIGN_IN_ALLOWLIST value.
    // The email must be verified too (C-04) — same rule as signInRefusal().
    function inDomain() {
      return authed()
        && request.auth.token.email_verified == true
        && (request.auth.token.email.matches(".*@highplainsbank[.]com$")
            || request.auth.token.email == "daniel@mcgareyconsulting.com");
    }

    function isMember(teamId) {
      return authed()
        && exists(/databases/$(db)/documents/team_members/$(teamId + "__" + request.auth.uid));
    }

    // The caller's teams: one get() of users/{uid}.team_ids, which is
    // server-maintained from team_members (lib/firebase/membership.ts).
    // `users` writes are denied below, so a client cannot forge team_ids.
    function myTeamIds() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('team_ids', []);
    }

    // Is the caller on any team this document was shared into? Used by rocks
    // and by scorecard measurables, which share the same `shared_team_ids`
    // shape (lib/rocks-share.ts, lib/scorecard-share.ts). hasAny() replaces
    // the old 8-way unroll: there is no cap on the number of shares any more
    // (proved in docs/spikes/P14-rules-hasany.md).
    function listSharedToMe(data) {
      return authed() && data.get('shared_team_ids', []).hasAny(myTeamIds());
    }

    // ---------- default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- organizations & users ----------
    match /organizations/{orgId} {
      allow read:  if inDomain();
      allow write: if false;
    }

    match /users/{uid} {
      allow read:  if inDomain();
      allow write: if false;
    }

    // ---------- teams & memberships (org directory) ----------
    // Soft directory: any signed-in in-domain user may read team names and
    // rosters. Team *data* (rocks, issues, meetings, …) is membership-gated
    // below.
    match /teams/{teamId} {
      allow read:  if inDomain();
      allow write: if false;
    }

    match /team_members/{id} {
      allow read:  if inDomain();
      allow write: if false;
    }

    // ---------- scorecard ----------
    // A measurable has one home team and an optional `shared_team_ids` — the
    // teams that pulled it onto their scorecard. A borrowing team can read the
    // row and its history; attaching/detaching a share and setting values are
    // Admin-SDK server actions (`requireTeamAccess`, `canEditMetricValues`).
    function metricSharedToMe() {
      return listSharedToMe(resource.data);
    }
    match /scorecard_metrics/{id} {
      allow read:  if admin() || isMember(resource.data.team_id) || metricSharedToMe();
      allow write: if false;
    }

    // Groups are named, ordered buckets within a period — same team gate as
    // the metrics that reference them by name.
    match /scorecard_groups/{id} {
      allow read:  if admin() || isMember(resource.data.team_id);
      allow write: if false;
    }

    // Entries carry no team of their own — they are keyed
    // `${metricId}__${weekStartDate}` — so they inherit their measurable's
    // visibility (a share is a *reference*: one set of values).
    match /scorecard_entries/{id} {
      function metricDoc() {
        return get(/databases/$(db)/documents/scorecard_metrics/$(resource.data.metric_id)).data;
      }
      function metricTeam() {
        return metricDoc().team_id;
      }
      allow read:  if admin() || isMember(metricTeam()) || listSharedToMe(metricDoc());
      allow write: if false;
    }

    // ---------- rocks ----------
    // Parent team members have full access; teams in shared_team_ids may read
    // (no cap). `listSharedToMe` is defined with the shared helpers above.
    function rockSharedToMe() {
      return listSharedToMe(resource.data);
    }
    // The whole rock, client half of lib/rocks-share.ts hasFullRockView:
    // parent team, a shared team, the rock's owner, or an assignee (the
    // rock carries `milestone_owner_ids`, rewritten on every save). Gates
    // the rock doc, its status history and its comments.
    function rockFullAccess(data) {
      return isMember(data.team_id)
        || listSharedToMe(data)
        || (authed()
            && (data.owner_id == request.auth.uid
                || data.get('milestone_owner_ids', []).hasAny([request.auth.uid])));
    }
    function rockFullAccessById(rockId) {
      return rockId is string
        && rockId != ''
        && exists(/databases/$(db)/documents/rocks/$(rockId))
        && rockFullAccess(get(/databases/$(db)/documents/rocks/$(rockId)).data);
    }
    function sourceRockVisibleToMe(rockId) {
      return rockId is string
        && rockId != ''
        && exists(/databases/$(db)/documents/rocks/$(rockId))
        && (
          isMember(get(/databases/$(db)/documents/rocks/$(rockId)).data.team_id)
          || listSharedToMe(get(/databases/$(db)/documents/rocks/$(rockId)).data)
        );
    }
    match /rocks/{id} {
      allow read:  if admin() || rockFullAccess(resource.data);
      allow write: if false;
    }

    // ---------- rock status updates (immutable history) ----------
    match /rock_status_updates/{id} {
      allow read:  if admin()
                   || isMember(resource.data.team_id)
                   || rockFullAccessById(resource.data.rock_id);
      allow write: if false;
    }

    // ---------- todos ----------
    match /todos/{id} {
      allow read: if admin()
                  // Your own to-do or milestone, from any team — a guest-team
                  // member assigned a milestone on another team's rock.
                  || (authed() && resource.data.owner_id == request.auth.uid)
                  || (isMember(resource.data.team_id)
                      && resource.data.visibility == "team")
                  // Guest team can see team-visible milestones of a rock
                  // shared into them (parent team_id is not theirs). Every
                  // team share is full (lib/rocks-share.ts); a team that sees
                  // a rock only through its people's milestones gets them
                  // server-side, not through a client read.
                  || (resource.data.visibility == "team"
                      && sourceRockVisibleToMe(resource.data.source_rock_id));
      allow write: if false;
    }

    // ---------- issues + per-user votes ----------
    match /issues/{id} {
      allow read:  if admin() || isMember(resource.data.team_id);
      allow write: if false;
    }

    // Votes: server-action only (castVote keeps the credit cap and the
    // denormalized issues.votes counter in one transaction).
    match /issue_votes/{id} {
      allow read:  if admin() || isMember(resource.data.team_id);
      allow write: if false;
    }

    // ---------- free-form comments on issues / rocks / to-dos ----------
    match /entity_comments/{id} {
      // A rock has one thread, filed under its parent team, readable by
      // everyone with the whole rock (docs/ROCK_SHARING_RULES.md). Other
      // entities stay team-scoped.
      function rockThread(data) {
        return data.entity_type == 'rock' && rockFullAccessById(data.entity_id);
      }
      allow read:  if admin()
                   || isMember(resource.data.team_id)
                   || rockThread(resource.data);
      allow write: if false;
    }

    // ---------- in-app notifications (per-user inbox) ----------
    // One row per recipient × event, written by server actions
    // (lib/firebase/notifications.ts). The client subscribes to its own rows
    // for the sidebar badge and the /notifications hub. A list query must
    // constrain `user_id == request.auth.uid` or the rule rejects it outright.
    match /notifications/{id} {
      allow read:  if authed() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    // ---------- headlines ----------
    // Cascading headlines reach target teams via app-layer filtering (rules
    // can't iterate target_team_ids; the query scopes by team_id).
    match /headlines/{id} {
      allow read:  if admin() || isMember(resource.data.team_id);
      allow write: if false;
    }

    // ---------- meeting agendas (templates) ----------
    // No client reads today; kept member-readable.
    match /agendas/{agendaId} {
      allow read:  if admin() || isMember(resource.data.team_id);
      allow write: if false;
    }

    // ---------- meetings (L10) ----------
    match /meetings/{meetingId} {
      allow read:  if admin() || isMember(resource.data.team_id);
      // Meeting state (driver, current_segment, ended_at, votes) changes only
      // through server actions; a client write would make the driver model
      // advisory.
      allow write: if false;

      function meetingTeam() {
        return get(/databases/$(db)/documents/meetings/$(meetingId)).data.team_id;
      }

      // End-of-meeting ratings, one doc per attendee, written server-side.
      match /effectiveness_scores/{scoreId} {
        allow read:  if admin() || isMember(meetingTeam());
        allow write: if false;
      }

      match /presence/{uid} {
        allow read:  if admin() || isMember(meetingTeam());
        allow write: if false;
      }
    }

    // ---------- per-entity activity trace ----------
    // One row per event on a to-do (lib/activity.ts), written only by server
    // actions. Readable on the same terms as the to-do itself: members see a
    // team-visible to-do's trace; a private one's is its owner's alone. A
    // list query must constrain `visibility` (and `owner_id` when private)
    // or the rule rejects it outright.
    match /entity_activity/{id} {
      allow read:  if admin()
                   || (isMember(resource.data.team_id)
                       && (resource.data.visibility == "team"
                           || resource.data.owner_id == request.auth.uid));
      allow write: if false;
    }

    // ---------- audit log (append-only, function-written) ----------
    // Populated exclusively by the onDocumentWrittenWithAuthContext Cloud
    // Function (functions/src/index.ts, Admin SDK); only admins may read it.
    match /audit_log/{eventId} {
      allow read:  if admin();
      allow write: if false;
    }

    // ---------- Google Tasks OAuth tokens (per-user, server-only) ----------
    // Admin SDK only (lib/google/tasks.ts). Clients must never read refresh
    // tokens. Default-deny above covers this; explicit rule documents intent.
    match /google_tasks_connections/{uid} {
      allow read, write: if false;
    }

    // One-time OAuth CSRF states for the Tasks connector (admin SDK only).
    match /oauth_csrf_states/{state} {
      allow read, write: if false;
    }
  }
}
