rules_version = '2';

// Firestore Security Rules for the EOS app.
// Mirrors the access patterns of the current Postgres RLS — gated on
// team membership via the team_members collection + Identity Platform
// custom claims (`role: "normal" | "admin"`).

service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- helpers ----------
    function authed() { return request.auth != null; }

    // Break-glass admin accounts allowlisted by email. These get full access
    // regardless of email domain — e.g. the consultant's account, which is not
    // on the Workspace domain and would otherwise be locked out by inDomain().
    function isAdminEmail() {
      return authed()
        && request.auth.token.email in ["mcgareyconsulting@gmail.com"];
    }

    // Admin = Identity Platform custom claim (role: "admin") OR an allowlisted
    // admin email above.
    function admin() {
      return (authed() && request.auth.token.role == "admin") || isAdminEmail();
    }

    // Workspace-domain perimeter (defense-in-depth). Primary enforcement is at
    // the Firebase Auth provider (Console → Authentication → Sign-in method →
    // Google → "Restrict by domain" = highplainsbank.com). These rules also gate
    // the broad org/user/team reads below so a token from outside the Workspace
    // can't enumerate them. Allowlisted admin emails are permitted alongside.
    function inDomain() {
      return isAdminEmail()
        || (authed()
            && request.auth.token.email.matches(".*@highplainsbank[.]com$"));
    }

    function isMember(teamId) {
      return authed()
        && exists(/databases/$(db)/documents/team_members/$(teamId + "__" + request.auth.uid));
    }

    function isLeader(teamId) {
      let m = get(/databases/$(db)/documents/team_members/$(teamId + "__" + request.auth.uid));
      return m != null && m.data.role == "leader";
    }

    // ---------- default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- organizations & users ----------
    match /organizations/{orgId} {
      allow read:  if inDomain();
      allow write: if admin();
    }

    match /users/{uid} {
      allow read:  if inDomain();
      allow write: if uid == request.auth.uid || admin();
    }

    // ---------- teams & memberships ----------
    match /teams/{teamId} {
      allow read:  if inDomain();
      allow write: if admin();
    }

    match /team_members/{id} {
      allow read:  if inDomain();
      allow write: if admin();
    }

    // ---------- join requests ----------
    // A teamless user requests to join a team; a team leader approves/denies.
    // The actual membership write happens via an admin-SDK server action, so
    // these client rules are defense-in-depth: a user may create/read their
    // own pending request; leaders read + decide their team's requests.
    match /team_join_requests/{id} {
      allow read:   if admin()
                    || resource.data.user_id == request.auth.uid
                    || isLeader(resource.data.team_id);
      allow create: if inDomain()
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.status == "pending";
      allow update, delete: if admin() || isLeader(resource.data.team_id);
    }

    // ---------- scorecard ----------
    match /scorecard_metrics/{id} {
      allow read, write: if admin() || isMember(resource.data.team_id);
      allow create:      if admin() || isMember(request.resource.data.team_id);
    }

    match /scorecard_entries/{id} {
      function metricTeam() {
        return get(/databases/$(db)/documents/scorecard_metrics/$(resource.data.metric_id)).data.team_id;
      }
      function createMetricTeam() {
        return get(/databases/$(db)/documents/scorecard_metrics/$(request.resource.data.metric_id)).data.team_id;
      }
      allow read, update, delete: if admin() || isMember(metricTeam());
      allow create:               if admin() || isMember(createMetricTeam());
    }

    // ---------- rocks ----------
    match /rocks/{id} {
      allow read, update, delete: if admin() || isMember(resource.data.team_id);
      allow create:               if admin() || isMember(request.resource.data.team_id);
    }

    // ---------- rock status updates (immutable history) ----------
    match /rock_status_updates/{id} {
      allow read:   if admin() || isMember(resource.data.team_id);
      allow create: if admin() || isMember(request.resource.data.team_id);
      // No update/delete from clients — history is append-only.
    }

    // ---------- todos ----------
    match /todos/{id} {
      allow read: if admin()
                  || (isMember(resource.data.team_id)
                      && (resource.data.visibility == "team"
                          || resource.data.owner_id == request.auth.uid));
      allow update, delete: if admin() || isMember(resource.data.team_id);
      allow create:         if admin() || isMember(request.resource.data.team_id);
    }

    // ---------- issues + per-user votes ----------
    match /issues/{id} {
      allow read, update, delete: if admin() || isMember(resource.data.team_id);
      allow create:               if admin() || isMember(request.resource.data.team_id);
    }

    match /issue_votes/{id} {
      // 3-per-team-per-user limit + count stacking are enforced in the server
      // action (Firestore transaction); rules just confirm ownership + membership.
      allow read:   if admin() || isMember(resource.data.team_id);
      allow create: if request.resource.data.user_id == request.auth.uid
                    && isMember(request.resource.data.team_id);
      allow update: if resource.data.user_id == request.auth.uid
                    && request.resource.data.user_id == request.auth.uid;
      allow delete: if resource.data.user_id == request.auth.uid;
    }

    // ---------- headlines ----------
    match /headlines/{id} {
      // Cascading headlines visible to target teams via app-layer filtering
      // (rules can't iterate target_team_ids efficiently; the query already
      // scopes by team_id, so this is enforced at query time).
      allow read:           if admin() || isMember(resource.data.team_id);
      allow update, delete: if admin() || isMember(resource.data.team_id);
      allow create:         if admin() || isMember(request.resource.data.team_id);
    }

    // ---------- meetings (L10) ----------
    match /meetings/{meetingId} {
      allow read, update, delete: if admin() || isMember(resource.data.team_id);
      allow create:               if admin() || isMember(request.resource.data.team_id);

      function meetingTeam() {
        return get(/databases/$(db)/documents/meetings/$(meetingId)).data.team_id;
      }

      // Peer effectiveness scores are written server-side (admin SDK) during
      // the Conclude segment; clients only read aggregates via server
      // components, so no client write path is needed.
      match /effectiveness_scores/{scoreId} {
        allow read:  if admin() || isMember(meetingTeam());
        allow write: if admin();
      }

      match /presence/{uid} {
        allow read:  if admin() || isMember(meetingTeam());
        allow write: if uid == request.auth.uid && isMember(meetingTeam());
      }
    }

    // ---------- audit log (append-only, function-written) ----------
    // Populated exclusively by the onDocumentWrittenWithAuthContext Cloud
    // Function (functions/src/index.ts), which writes via the Admin SDK and
    // therefore bypasses these rules entirely. The `allow write: if false`
    // here is what guarantees clients can never forge or tamper with an
    // audit row — only admins may even read the log.
    match /audit_log/{eventId} {
      allow read:  if admin();
      allow write: if false;
    }
  }
}
