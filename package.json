{
  "name": "eos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"lib/**/*.test.ts\" \"components/**/*.test.ts\" \"app/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "team:info": "tsx scripts/team-info.ts",
    "import:csv": "tsx scripts/import-csv.ts",
    "users:seed": "tsx scripts/import-users.ts",
    "team:delete": "tsx scripts/delete-team.ts",
    "accounts:create": "tsx scripts/create-accounts.ts",
    "admin:set-role": "tsx scripts/set-admin-role.ts",
    "member:set-role": "tsx scripts/set-member-role.ts",
    "user:reassign": "tsx scripts/reassign-user.ts",
    "user:merge": "tsx scripts/merge-import-user.ts",
    "db:copy": "tsx scripts/copy-db.ts",
    "backup:restore-test": "bash scripts/restore-test.sh",
    "ship": "bash scripts/deploy.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "firebase-tools": "^15.32.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
