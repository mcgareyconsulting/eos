{
  "name": "eos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"lib/**/*.test.ts\" \"components/**/*.test.ts\" \"app/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-hpb-eos",
    "emulators:all": "npm --prefix functions run build && firebase emulators:start --only auth,firestore,functions --project demo-hpb-eos",
    "seed": "tsx scripts/seed-demo.ts",
    "reset": "tsx scripts/reset-demo.ts",
    "team:info": "tsx scripts/team-info.ts",
    "import:csv": "tsx scripts/import-csv.ts",
    "backfill:groups": "tsx scripts/backfill-scorecard-groups.ts",
    "team:delete": "tsx scripts/delete-team.ts",
    "accounts:create": "tsx scripts/create-accounts.ts",
    "admin:set-role": "tsx scripts/set-admin-role.ts",
    "user:reassign": "tsx scripts/reassign-user.ts",
    "db:copy": "tsx scripts/copy-db.ts",
    "ship": "bash scripts/deploy.sh",
    "backfill:focus": "tsx scripts/backfill-weekly-focus.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "firebase-tools": "^15.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
