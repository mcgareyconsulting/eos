{
  "name": "eos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"lib/**/*.test.ts\" \"components/**/*.test.ts\" \"app/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:rules": "firebase emulators:exec --config tests/rules/firebase.json --project demo-eos-rules --only firestore \"tsx --test tests/rules/firestore.rules.test.ts tests/rules/parity.rules.test.ts\"",
    "spike:p14": "firebase emulators:exec --config spikes/firebase.json --project demo-p14-hasany --only firestore \"tsx --test spikes/p14-hasany.test.ts\"",
    "team:info": "tsx scripts/team-info.ts",
    "import:csv": "tsx scripts/import-csv.ts",
    "users:seed": "tsx scripts/import-users.ts",
    "team:delete": "tsx scripts/delete-team.ts",
    "accounts:create": "tsx scripts/create-accounts.ts",
    "admin:set-role": "tsx scripts/set-admin-role.ts",
    "operator:set-claim": "tsx scripts/set-operator-claim.ts",
    "member:set-role": "tsx scripts/set-member-role.ts",
    "user:reassign": "tsx scripts/reassign-user.ts",
    "user:merge": "tsx scripts/merge-import-user.ts",
    "scorecard:share-repair": "tsx scripts/scorecard-share-repair.ts",
    "home:rocks-why": "tsx scripts/home-rocks-why.ts",
    "person:scorecards": "tsx scripts/person-scorecards.ts",
    "scorecard:audit": "tsx scripts/scorecard-audit.ts",
    "scorecard:merge-duplicates": "tsx scripts/scorecard-merge-duplicates.ts",
    "users:backfill-team-ids": "tsx scripts/backfill-team-ids.ts",
    "issues:backfill-comment-counts": "tsx scripts/backfill-issue-comment-counts.ts",
    "feedback:import": "tsx scripts/import-feedback-seed.ts",
    "feedback:access": "tsx scripts/feedback-access.ts",
    "db:copy": "tsx scripts/copy-db.ts",
    "backup:restore-test": "bash scripts/restore-test.sh",
    "ship": "bash scripts/deploy.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.14.0",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "^15.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
